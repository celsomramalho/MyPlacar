{
  "headers": [
    { 
		"source": "/sw.js", 
		"headers": [
		  { 
			"key": "Cache-Control", 
			"value": "public, max-age=31536000, immutable" }, 
		  { 
			"key": "Service-Worker-Allowed", 
			"value": "/" 
		  }] 
	},
	{ 
	    "source": "/manifest.json", 
		"headers": [
		  { 
		    "key": "Cache-Control", 
		    "value": "public, max-age=31536000" 
		  }] 
	},
    { 
	    "source": "/assets/**", 
		"headers": [
		  { 
		    "key": "Cache-Control", 
			"value": "public, max-age=31536000, immutable" 
		  }] 
    }
  ],
  "rewrites": [
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/manifest.json",
      "destination": "/manifest.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}