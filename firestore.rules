rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // ⚠️ CORREÇÃO: isAdmin() usava get() sem exists() — se o documento
    // users/{email} não existir (usuários antigos com ID = PIN), o get()
    // lança permission-denied e contamina a avaliação de TODAS as outras
    // regras na mesma requisição, inclusive as com "if true".
    // Solução: exists() antes do get() garante short-circuit seguro.
    function isAdmin() {
      return isAuthenticated() && 
        request.auth.token.email != null && (
          (
            exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
            get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.isAdmin == true
          ) ||
          (request.auth.token.email == "celsomramalho@gmail.com" && request.auth.token.email_verified == true)
        );
    }

    // ⚠️ CORREÇÃO: isEmailOwner() chamava request.auth.token.email sem
    // verificar isAuthenticated() primeiro — se request.auth for null,
    // acessar .token.email lança erro e também contamina outras regras.
    // Já estava com isAuthenticated() && ... mas mantido explícito aqui
    // para clareza e segurança em revisões futuras.
    function isEmailOwner(userEmail) {
      return isAuthenticated() && request.auth.token.email == userEmail;
    }

    match /communications/{commId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAuthenticated() && (
        isAdmin() || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'poll', 'readBy', 'replies']) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['poll']) || 
           request.resource.data.poll.totalVotes == resource.data.poll.totalVotes + 1) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['replies']) || 
           request.resource.data.replies.size() == (resource.data.keys().contains('replies') ? resource.data.replies.size() : 0) + 1)
        )
      );
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isEmailOwner(userId) || isAdmin();
      match /partners/{partnerId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /matches/{matchId} {
      allow read, write: if true;
    }

    match /live_matches/{pin} {
      allow read, write: if true;
    }

    match /user_partners_metadata/{userEmail} {
      allow read, write: if true;
    }

    match /user_queue_metadata/{userEmail} {
      allow read, write: if true;
    }

    match /events/{eventPin} {
      allow read: if true;
      allow write: if isAdmin();
      match /entries/{entryEmail} {
        allow read: if isAuthenticated();
        allow write: if isEmailOwner(entryEmail) || isAdmin();
      }
    }

    match /user_registrations/{userEmail} {
      allow read: if true;
      allow write: if isEmailOwner(userEmail) || isAdmin() || isAuthenticated();
      match /events/{eventPin} {
        allow read: if true;
        allow write: if isEmailOwner(userEmail) || isAdmin() || isAuthenticated();
      }
    }

    match /sport_icons/{iconId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /category_icons/{iconId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Regras para Login Rápido do Relógio ─────────────────────────────────────
    match /watch_tokens/{tokenId} {
      // Permite ler um token individual (get), mas proíbe listar todos (list) por segurança
      allow get: if true;
      allow list: if false;

      // Permite criar um novo token, desde que inicie com status 'pending'
      allow create: if request.resource.data.status == 'pending';

      // Permite atualizar:
      // Apenas se o token original estiver pendente e não tiver expirado, e se o novo status for 'approved'
      allow update: if resource.data.status == 'pending' &&
                       request.resource.data.status == 'approved' &&
                       resource.data.expiresAt > request.time.toMillis();

      // Permite exclusão (limpeza do token após o login concluído)
      allow delete: if true;
    }
	
		
    // Catch-all: nega tudo que não foi coberto acima.
    // Mantido como "false" (e não isAdmin()) exatamente para evitar
    // que o get() interno do isAdmin() dispare em paths desconhecidos.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
